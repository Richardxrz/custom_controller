<?xml version="1.0"?>
<robot name="demo6">
  <material name="base"><color rgba="0.20 0.25 0.28 1"/></material>
  <material name="al"><color rgba="0.72 0.76 0.78 1"/></material>
  <material name="yellow"><color rgba="0.85 0.65 0.12 1"/></material>
  <material name="dark"><color rgba="0.12 0.14 0.16 1"/></material>

  <link name="base_link">
    <visual><geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="base"/></visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="3"/>
  </joint>
  <link name="link1">
    <visual><origin xyz="0 0 0.06"/><geometry><box size="0.12 0.12 0.10"/></geometry><material name="yellow"/></visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="3"/>
  </joint>
  <link name="link2">
    <visual><origin xyz="0.17 0 0"/><geometry><box size="0.34 0.08 0.08"/></geometry><material name="al"/></visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.34 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="0.2" effort="20" velocity="3"/>
  </joint>
  <link name="link3">
    <visual><origin xyz="0.14 0 0"/><geometry><box size="0.28 0.07 0.07"/></geometry><material name="yellow"/></visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="8" velocity="6"/>
  </joint>
  <link name="link4">
    <visual><origin rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.10"/></geometry><material name="al"/></visual>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="8" velocity="6"/>
  </joint>
  <link name="link5">
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.07 0.07"/></geometry><material name="dark"/></visual>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="8"/>
  </joint>
  <link name="link6">
    <visual><origin xyz="0.04 0 0"/><geometry><cylinder radius="0.035" length="0.08"/></geometry><material name="al"/></visual>
  </link>

  <joint name="end_joint" type="fixed">
    <parent link="link6"/><child link="end_link"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
  </joint>
  <link name="end_link">
    <visual><geometry><box size="0.02 0.06 0.06"/></geometry><material name="dark"/></visual>
  </link>
</robot>
